# SkillSwap backend environment template.
# Copy to ".env" (git-ignored) and fill in your own values. Never commit real values.

# --- Supabase ---
SUPABASE_URL=your-supabase-project-url
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# --- LLM provider (server-side only) ---
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=your-chosen-model-name
LLM_TIMEOUT_SECONDS=15
AI_MAX_CANDIDATES=20

# --- App ---
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173

